{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": false,
        },
        {
            "name": "distill_videomae",
            "type": "debugpy",
            "request": "launch",
            "program": "main.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": false,
            "args": [
                "-td",
                "data/wds/k400/k400_train_allframe",
                "-vd",
                "data/wds/k400/wds_k400_val_allframe",
                "-w",
                "2",
                "-b",
                "8",
                "--grad_accum",
                "3",
                "-e",
                "4", // エポック数
                "--devices",
                "1", // 使用するGPU数
                "-m",
                "attn_distill",
                "-s_hdim",
                "128",
                "-s_fdim",
                "512",
                "-s_head",
                "4",
                "-s_layer",
                "6",
                "-lr",
                "1e-4",
                "--clips_per_video",
                "1",
            ]
        },
        {
            "name": "leaps_videomae",
            "type": "debugpy",
            "request": "launch",
            "program": "inference.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": false,
            "args": [
                "-etag",
                "exdebug",
                "-td",
                "data/wds/k400/k400_train_allframe",
                "-vd",
                "data/wds/k400/wds_k400_val_allframe",
                "-w",
                "2",
                "-b",
                "2",
                "-b_v",
                "2",
                "--grad_accum",
                "3",
                "-e",
                "4", // エポック数
                "--devices",
                "1", // 使用するGPU数
                "-m",
                "leaps_vivit",
                "-cls_model",
                "google/vivit-b-16x2-kinetics400",
                "-lr",
                "3e-5",
                "--token_retention_rate",
                "0.5",
                "-fs",
                "16",
                // "none",
                // "token",
                // "--multi_crop",
                "--max_val_step",
                "10",
                // "-use_teacher",
                // "--teacher_model_name",
                // "OpenGVLab/VideoMAEv2-Base",
                // "MCG-NJU/videomae-base",
                // "-teacher_calib",
            ]
        },
        {
            "name": "visualize leaps",
            "type": "debugpy",
            "request": "launch",
            "program": "visualize.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": false,
            "args": [
                "-fs",
                "16",
                "-leaps_r",
                "0.25",
            ]
        },
        {
            "name": "distill leaps",
            "type": "debugpy",
            "request": "launch",
            "program": "distill.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": false,
            "args": [
                "-fs",
                "16",
                "-td",
                "data/wds/k400/k400_train_allframe", // トレーニングデータのディレクトリ
                "-vd",
                "data/wds/k400/wds_k400_val_allframe", // 検証データのディレクトリ
                "--clips_per_video",
                "1",
            ]
        },
    ]
}
